  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@tanstack/react-query": "^5.80.0",
    "@thefridge/shared": "*",
    "clsx": "^2.1.1",
    "jose": "^6.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.66.0",
    "mongoose": "^8.18.0",
    "next": "^15.5.0",
    "openai": "^7.47.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.1.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.3.0",
    "vaul": "^1.1.2",
    "zod": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
