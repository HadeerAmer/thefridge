{
  "name": "@thefridge/web",
  "version": "0.1.0",
  "private": true,
  "description": "The Fridge customer app, admin dashboard and cloud API",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx --conditions=react-server --env-file=.env scripts/seed.ts",
