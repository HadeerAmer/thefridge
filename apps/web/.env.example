# --- MongoDB (needs a replica set for transactions: local rs0 or Atlas) ---
# The seed/reset script only works on databases whose name ends in "_demo".
MONGODB_URI="mongodb://127.0.0.1:27017/thefridge_demo?replicaSet=rs0"

# --- Session signing (any long random string) ---
SESSION_SECRET="dev-only-change-me-0f3c9a7e5b2d4c18a6e7f9b1c2d3e4f5"

# --- Fridge simulator (the "real" machines) ---
FRIDGE_API_URL="http://localhost:4000"
# Key the cloud sends to the machine API (must match MACHINE_API_KEY in apps/fridge-sim/.env)
FRIDGE_API_KEY="dev-machine-api-key"
# Shared secret the machines use to sign webhooks + redeem calls (must match WEBHOOK_SECRET there)
MACHINE_WEBHOOK_SECRET="dev-webhook-secret"

# --- Demo mode: fixed OTP + one-tap demo sign-in buttons ---
DEMO_MODE="true"
DEMO_OTP="1234"

# --- "Ask The Fridge" AI assistant ---
# auto = OpenAI if OPENAI_API_KEY is set, else Claude if ANTHROPIC_API_KEY is set, else the built-in rules engine.
AI_PROVIDER="auto"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
