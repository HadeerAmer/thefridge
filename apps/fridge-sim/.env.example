# Port the simulator listens on (machine API, docs and touchscreen UI)
PORT=4000
# Cloud backend that receives webhooks and answers QR redeem calls
CLOUD_URL=http://localhost:3000
# Key the cloud must send in x-api-key (FRIDGE_API_KEY in apps/web/.env)
MACHINE_API_KEY=dev-machine-api-key
# Secret used to sign webhooks (MACHINE_WEBHOOK_SECRET in apps/web/.env)
WEBHOOK_SECRET=dev-webhook-secret
# Where machine state is persisted between restarts
DATA_FILE=.data/state.json
